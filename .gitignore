# ============================================================
# .gitignore — Files and folders excluded from version control
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg

# --- Virtual Environments ---
.venv/
venv/
venv311/
env/
ENV/

# --- Environment Variables (NEVER commit secrets!) ---
.env

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*.iml

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Agent State Files (may contain sensitive conversation data) ---
marketingcontext.txt
test1.json

# --- Logs ---
*.log
