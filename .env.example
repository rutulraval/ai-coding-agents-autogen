# ============================================================
# .env.example — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit your real .env file to version control.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your actual keys
# ============================================================

# Gemini API Key (used as OPENAI_API_KEY for AutoGen's OpenAI-compatible client)
# Get yours at: https://aistudio.google.com/app/apikey
OPENAI_API_KEY="your-gemini-api-key-here"

# Tavily Search API Key
# Get yours at: https://tavily.com
TAVILY_API_KEY="tvly-your-key-here"

# Optional: Local LLM server (e.g. Ollama, LM Studio, custom OpenAI-compat API)
MANUS_API_KEY="your-local-api-key-here"
MANUS_API_BASE="http://localhost:8000/v1"
